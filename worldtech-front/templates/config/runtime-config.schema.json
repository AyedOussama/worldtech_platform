{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorldTech public runtime configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "appName",
    "apiBaseUrl",
    "googleLoginEnabled",
    "telemetryEnabled",
    "buildVersion"
  ],
  "properties": {
    "appName": {
      "const": "WorldTech"
    },
    "apiBaseUrl": {
      "type": "string",
      "pattern": "^/api/web/v[1-9][0-9]*$"
    },
    "googleLoginEnabled": {
      "type": "boolean"
    },
    "telemetryEnabled": {
      "type": "boolean"
    },
    "buildVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  }
}

